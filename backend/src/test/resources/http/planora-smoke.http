# Ejecutar en orden contra un backend conectado a una base de pruebas.
# Cada registro crea un usuario; no ejecutar contra una base de producción.
# El login actual devuelve 200 sin token ni sesión. Por eso el CRUD autenticado
# no puede probarse por HTTP todavía. Los tests Java cubren controladores,
# servicios y repositorios; estas peticiones comprueban el contrato disponible.
@baseUrl = http://localhost:8080

### Registro con datos únicos por ejecución
< {%
    const suffix = Date.now().toString() + Math.floor(Math.random() * 1000000);
    client.global.set("smokeUsername", "smoke-" + suffix);
    client.global.set("smokeEmail", "smoke-" + suffix + "@planora.test");
%}
POST {{baseUrl}}/api/auth/register
Content-Type: application/json

{
    "username": "{{smokeUsername}}",
    "email": "{{smokeEmail}}",
    "password": "SmokePassword123",
    "firstName": "Smoke",
    "lastName": "Test",
    "primaryCurrencyId": 1
}

> {%
    client.test("Registro: 201", function () {
        client.assert(response.status === 201, "Se esperaba 201");
    });
%}

### Un email repetido debe rechazarse
POST {{baseUrl}}/api/auth/register
Content-Type: application/json

{
    "username": "{{smokeUsername}}",
    "email": "{{smokeEmail}}",
    "password": "SmokePassword123",
    "firstName": "Smoke",
    "lastName": "Test",
    "primaryCurrencyId": 1
}

> {%
    client.test("Email duplicado: 409", function () {
        client.assert(response.status === 409, "Se esperaba 409");
        client.assert(response.body.code === "EMAIL_ALREADY_IN_USE", "Código incorrecto");
    });
%}

### Validación del registro
POST {{baseUrl}}/api/auth/register
Content-Type: application/json

{
    "username": "",
    "email": "{{smokeEmail}}",
    "password": "SmokePassword123",
    "firstName": "Smoke",
    "lastName": "Test",
    "primaryCurrencyId": 1
}

> {%
    client.test("Username vacío: 400", function () {
        client.assert(response.status === 400, "Se esperaba 400");
        client.assert(response.body.code === "VALIDATION_ERROR", "Código incorrecto");
        client.assert(response.body.errors.some(e => e.field === "username"), "Falta error de username");
    });
%}

### Comprobación de credenciales (aún no entrega token ni sesión)
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
    "email": "{{smokeEmail}}",
    "password": "SmokePassword123"
}

> {%
    client.test("Credenciales válidas: 200", function () {
        client.assert(response.status === 200, "Se esperaba 200");
    });
%}

### El parámetro userId no autentica ni autoriza al cliente
GET {{baseUrl}}/api/purchases?userId=00000000-0000-0000-0000-000000000001

> {%
    client.test("Recurso protegido sin autenticación: 403", function () {
        client.assert(response.status === 403, "Se esperaba 403");
    });
%}
